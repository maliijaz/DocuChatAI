# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="your-secret-here-run-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# AI Providers — configure at least one free provider OR Anthropic
# Free tier: Groq (https://console.groq.com)
GROQ_API_KEY="gsk_..."

# Paid tier: Anthropic Claude (https://console.anthropic.com) — required for Pro/Enterprise models
ANTHROPIC_API_KEY="sk-ant-..."

# Stripe — optional, leave empty to disable payments
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_ENTERPRISE_PRICE_ID="price_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Google OAuth — optional
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
