# Database — Postgres (e.g. a free Neon project: https://neon.tech)
# DATABASE_URL should be the pooled connection string, DATABASE_URL_UNPOOLED
# the direct one (used by Prisma for migrations/db push).
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-secret-here-run-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# AI provider — Groq (free): https://console.groq.com
GROQ_API_KEY="gsk_..."

# Google OAuth — optional
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
